<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend"
        mc:Ignorable="d"
        Title="JournalApp" 
        Height="720" Width="1080"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="75*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" 
                    Content="+" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Height="40" 
                    Margin="2"
                    Click="AddFolder_Click"/>

            <ListView Grid.Row="1" x:Name="sp_Files" Margin="0,2,0,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded}">
                            <Expander.Header>
                                <Grid>
                                    <TextBlock Text="{Binding FolderName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" 
                                             KeyDown="FolderRenameTextBox_KeyDown"
                                             LostFocus="FolderRenameTextBox_LostFocus"
                                             IsVisibleChanged="RenameTextBox_IsVisibleChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Expander.Header>

                            <Expander.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Átnevezés" Click="EnableFolderRename_Click" CommandParameter="{Binding}"/>
                                    <MenuItem Header="Új jegyzet ide" Click="AddNoteToFolder_Click" CommandParameter="{Binding}"/>
                                    <MenuItem Header="Törlés" Click="DeleteFolder_Click" CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Expander.ContextMenu>

                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,2,2,2">
                                            <Button Content="{Binding Title}" HorizontalAlignment="Stretch" Click="NoteButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Átnevezés" Click="EnableNoteRename_Click" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Törlés" Click="DeleteNote_Click" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>

                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                                     HorizontalAlignment="Stretch"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="NoteRenameTextBox_KeyDown"
                                                     LostFocus="NoteRenameTextBox_LostFocus"
                                                     IsVisibleChanged="RenameTextBox_IsVisibleChanged">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBox Grid.Column="1" 
                 Text="{Binding CurrentNote.Content, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"/>
    </Grid>
</Window>